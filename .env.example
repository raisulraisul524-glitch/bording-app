# Server
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# Admin login (used once by `npm run create-admin` to seed the admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Twilio (get these from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Day of month (1-28) to auto-send the monthly payment reminder SMS
REMINDER_DAY_OF_MONTH=1
